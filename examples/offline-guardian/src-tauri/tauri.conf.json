{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Offline Guardian Example",
  "version": "0.1.0",
  "identifier": "com.superinstance.offline-guardian-example",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Offline Guardian",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "offline-guardian": {
      "deadbandSecs": 5,
      "escalationQueueSecs": 300,
      "escalationReadonlySecs": 1800,
      "escalationOfflineSecs": 7200,
      "tickSecs": 1,
      "initialTier": "cortex"
    }
  }
}
